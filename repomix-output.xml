[sTL, sTR, eTR, eTL], // Top spine
[sBL, eBL, eBR, sBR], // Bottom flat
[sTL, eTL, eBL, sBL], // Left sloped face
[sTR, sBR, eBR, eTR], // Right sloped face
[sTL, sBL, sBR, sTR], // Start cap
[eTL, eTR, eBR, eBL], // End cap
