            <div class="wheel-cell" id="whl-2"><span>RL</span><div class="whl-bar"><i id="whl-bar-2"></i></div></div>
            <div class="wheel-cell" id="whl-3"><span>RR</span><div class="whl-bar"><i id="whl-bar-3"></i></div></div>
          </div>
        </div>

        <!-- Vitals Bar (HP & Blood mL from GoldSrcPhysicsEngine.getVitals()) -->
